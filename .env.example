# coming-soon | main
NEXT_PUBLIC_APP_MODE=coming-soon
# 0 닫음 · 1 열림 · 3 event.ts 접수 시각 기준
NEXT_PUBLIC_REGISTRATION_OPEN=3
# 2차 대기: 비우면 event.ts 구간, 0 끔, 1 UI만 강제(2차 종료 후에도 CTA 봉인 유지)
NEXT_PUBLIC_REGISTRATION_ROUND2_PAUSE=
# 2차 대기 안내: tooltip(버튼 말풍선) · standby(전체 모달)
NEXT_PUBLIC_REGISTRATION_ROUND2_UI=tooltip

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL_ADMIN=
# 관리자 환불 배치 API. 미배포·끔이면 0
NEXT_PUBLIC_ADMIN_REFUND_BATCH=1

# 로컬 개발용. test/prod Docker 빌드는 GitHub Secret (README Secret 표 참고)
# 1 출발 그룹 UI·수정, 그 외(비움·0) 끔
NEXT_PUBLIC_START_GROUP=0
# 1 할인 path(/discount/*), 그 외(비움·0) 끔
NEXT_PUBLIC_DISCOUNT_LINK=0

# test-marvelrun · marvelrun2026 (배포는 Variable TEST_/PROD_FRONTEND_EVENT_ID)
NEXT_PUBLIC_EVENT_ID=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=
# off | on
NEXT_PUBLIC_BGM=off

GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
NAVER_ANALYTICS_ID=
